<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Turntable viewed from above (top-down), matching the reference image:
        - Large platter circle (white)
        - Vinyl record with concentric grooves (orange strokes on white)
        - Orange center label with white spindle hole
        - Tonearm sweeping from top-right pivot down to the record
        - Tonearm pivot at top-right corner
        - Tonearm head/cartridge where it meets the record
        - Small control dots on the left side (decorative)
    -->

    <!-- Platter base ring (outer white circle) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,56 m -34,0 a 34,34 0 1,0 68,0 a 34,34 0 1,0 -68,0 Z" />

    <!-- Platter inner (orange tint creates a ring effect) -->
    <path
        android:fillColor="#FF8C42"
        android:pathData="M 54,56 m -30,0 a 30,30 0 1,0 60,0 a 30,30 0 1,0 -60,0 Z" />

    <!-- Vinyl record (white disc on top of platter) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,56 m -26,0 a 26,26 0 1,0 52,0 a 26,26 0 1,0 -52,0 Z" />

    <!-- Vinyl grooves: concentric circles (orange strokes) -->
    <path
        android:strokeColor="#FF8C42"
        android:strokeWidth="0.9"
        android:fillColor="#00000000"
        android:pathData="M 54,56 m -22,0 a 22,22 0 1,0 44,0 a 22,22 0 1,0 -44,0 Z" />
    <path
        android:strokeColor="#FF8C42"
        android:strokeWidth="0.7"
        android:fillColor="#00000000"
        android:pathData="M 54,56 m -18,0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0 Z" />
    <path
        android:strokeColor="#FF8C42"
        android:strokeWidth="0.6"
        android:fillColor="#00000000"
        android:pathData="M 54,56 m -14,0 a 14,14 0 1,0 28,0 a 14,14 0 1,0 -28,0 Z" />
    <path
        android:strokeColor="#FF8C42"
        android:strokeWidth="0.5"
        android:fillColor="#00000000"
        android:pathData="M 54,56 m -10,0 a 10,10 0 1,0 20,0 a 10,10 0 1,0 -20,0 Z" />

    <!-- Center label (orange circle) -->
    <path
        android:fillColor="#FF6B1A"
        android:pathData="M 54,56 m -6,0 a 6,6 0 1,0 12,0 a 6,6 0 1,0 -12,0 Z" />

    <!-- Spindle hole (white dot in center) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 54,56 m -1.5,0 a 1.5,1.5 0 1,0 3,0 a 1.5,1.5 0 1,0 -3,0 Z" />

    <!-- Tonearm: thick white bar from top-right pivot to record edge -->
    <!-- Pivot at ~(88, 26), tip at ~(66, 48) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 89,25 L 93,21 L 68,50 L 64,46 Z" />

    <!-- Tonearm pivot base (large white circle at top-right) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 90,28 m -7,0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0 Z" />

    <!-- Tonearm pivot inner (orange dot) -->
    <path
        android:fillColor="#FF6B1A"
        android:pathData="M 90,28 m -3,0 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0 Z" />

    <!-- Tonearm head/cartridge (small rectangle where needle meets record) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,44 L 68,44 L 68,52 L 60,52 Z" />

    <!-- Control dots on left side (decorative, like buttons) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 20,40 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 20,52 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 20,64 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0 Z" />

    <!-- Small speed selector line (left side, decorative) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M 16,30 L 24,30" />

</vector>