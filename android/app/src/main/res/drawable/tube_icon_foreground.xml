<?xml version="1.0" encoding="utf-8"?>
<!--
  tube_icon_foreground.xml — pathephon / gramophone silhouette (white).
  Design: classic HMV-style horn gramophone.
    • Large flared horn (upper-left, opening up-right)
    • Curved tone-arm connecting horn to the turntable
    • Cylindrical platter with crank handle on the side
    • Rectangular wooden base box

  Drawn in pure white (#FFFFFFFF) so it reads cleanly on the orange sunset
  gradient background. Safe for Android 13+ monochrome/themed icon rendering.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Horn: ellipse-shaped opening, flaring from a narrow neck.
      Path traces an oval opening on the upper-left, narrowing toward the
      center where it meets the tone arm.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
          M22,30
          C16,22 22,14 34,14
          C50,14 64,20 76,32
          C82,38 86,46 82,52
          C78,58 70,58 62,54
          C50,48 36,42 28,42
          C22,42 18,38 22,30 Z" />

    <!-- Inner horn shadow (subtle contour) -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="
          M30,28
          C26,24 30,20 38,20
          C50,20 60,24 70,32
          C74,36 76,42 72,46
          C68,50 62,48 56,44
          C46,38 36,34 32,34
          C28,34 26,32 30,28 Z" />

    <!--
      Tone arm: curved tube connecting horn neck (right side of horn) to
      the pickup point above the platter.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="
          M70,46
          C76,52 78,60 76,66
          C74,72 70,74 66,74" />

    <!--
      Platter: oval disc seen from a slight angle.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
          M50,76
          C50,72 56,70 66,70
          C76,70 82,72 82,76
          C82,80 76,82 66,82
          C56,82 50,80 50,76 Z" />

    <!-- Vinyl record on top of platter (dark inner circle to suggest grooves) -->
    <path
        android:fillColor="#33FF3B30"
        android:pathData="
          M54,76
          C54,73.5 59,72 66,72
          C73,72 78,73.5 78,76
          C78,78.5 73,80 66,80
          C59,80 54,78.5 54,76 Z" />

    <!-- Center spindle (white dot) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M65,76 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0" />

    <!--
      Crank handle on the right side of the base.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="
          M82,80
          C88,80 92,82 92,86
          C92,90 88,92 84,90" />

    <!--
      Base box: rectangular wooden cabinet under the platter.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
          M40,82
          L88,82
          L88,94
          C88,96 86,97 84,97
          L44,97
          C42,97 40,96 40,94
          Z" />

    <!-- Subtle base shadow line -->
    <path
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M44,90 L84,90" />
</vector>
