<?xml version="1.0" encoding="utf-8"?>
<!--
  data_extraction_rules.xml — Android 12+ backup / device-transfer rules.
  We back up: EQ presets, bookmarks, last playback position.
  We DO NOT back up: cached album art, raw audio files.
-->
<data-extraction-rules xmlns:android="http://schemas.android.com/apk/res/android">
    <cloud-backup>
        <include domain="sharedpref" path="audiobook_state.xml" />
        <include domain="sharedpref" path="eq_presets.xml" />
        <include domain="database" path="audiox64.db" />
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="audiobook_state.xml" />
        <include domain="sharedpref" path="eq_presets.xml" />
        <include domain="database" path="audiox64.db" />
    </device-transfer>
</data-extraction-rules>
