<?xml version="1.0" encoding="utf-8"?>
<!--
  tube_icon_background.xml — linear sunset gradient.
  Mirrors the audio-converter app icon background for visual continuity
  across the SwanLab product line (same hand, same palette).

  Gradient: #FF3B30 (red) → #FF9500 (orange) → #FFCC00 (yellow)
  Angle:    270 (top → bottom)
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FF3B30"
        android:centerColor="#FF9500"
        android:endColor="#FFCC00"
        android:angle="270" />
</shape>
