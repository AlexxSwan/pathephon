<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Turntable (record player) viewed from above-angle, matching reference:
        - Square black body with rounded corners
        - Black platter with white vinyl record on top
        - Black center label on the record with white spindle
        - Curved tonearm from top-right pivot to the record
        - Speed slider on right side (vertical bar with knob)
        - Round knob + square button at bottom-left
        - 45rpm adapter hole at top-right corner
        - Four feet under the body (small rectangles)
        Centered in 108x108 canvas.
    -->

    <!-- ===== BODY (black square, rounded corners) ===== -->
    <path
        android:fillColor="#1A1A1A"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M 22,28
            L 86,28
            C 89,28 91,30 91,33
            L 91,82
            C 91,85 89,87 86,87
            L 22,87
            C 19,87 17,85 17,82
            L 17,33
            C 17,30 19,28 22,28
            Z" />

    <!-- ===== PLATTER (large black circle, the turntable disc) ===== -->
    <path
        android:fillColor="#000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1"
        android:pathData="M 48,58
            m -22,0
            a 22,22 0 1,0 44,0
            a 22,22 0 1,0 -44,0
            Z" />

    <!-- Platter rim highlight (thin white ring just inside) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.5"
        android:fillColor="#00000000"
        android:pathData="M 48,58
            m -20,0
            a 20,20 0 1,0 40,0
            a 20,20 0 1,0 -40,0
            Z" />

    <!-- ===== VINYL RECORD (white circle on the platter, slightly smaller) ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48,58
            m -16,0
            a 16,16 0 1,0 32,0
            a 16,16 0 1,0 -32,0
            Z" />

    <!-- Vinyl grooves (concentric circles, thin black strokes) -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="0.4"
        android:fillColor="#00000000"
        android:pathData="M 48,58
            m -14,0
            a 14,14 0 1,0 28,0
            a 14,14 0 1,0 -28,0
            Z" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="0.3"
        android:fillColor="#00000000"
        android:pathData="M 48,58
            m -11,0
            a 11,11 0 1,0 22,0
            a 11,11 0 1,0 -22,0
            Z" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="0.3"
        android:fillColor="#00000000"
        android:pathData="M 48,58
            m -8,0
            a 8,8 0 1,0 16,0
            a 8,8 0 1,0 -16,0
            Z" />

    <!-- ===== CENTER LABEL (black circle on the record) ===== -->
    <path
        android:fillColor="#000000"
        android:pathData="M 48,58
            m -5,0
            a 5,5 0 1,0 10,0
            a 5,5 0 1,0 -10,0
            Z" />

    <!-- ===== SPINDLE (white dot in the very center) ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 48,58
            m -1,0
            a 1,1 0 1,0 2,0
            a 1,1 0 1,0 -2,0
            Z" />

    <!-- ===== TONEARM (curved bar from top-right pivot to the record) ===== -->
    <!-- Pivot base (large circle at top-right of body) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="0.5"
        android:pathData="M 78,38
            m -5,0
            a 5,5 0 1,0 10,0
            a 5,5 0 1,0 -10,0
            Z" />

    <!-- Pivot inner (black dot) -->
    <path
        android:fillColor="#000000"
        android:pathData="M 78,38
            m -2,0
            a 2,2 0 1,0 4,0
            a 2,2 0 1,0 -4,0
            Z" />

    <!-- Tonearm shaft: from pivot (78,38) curving down-left to headshell (54,52) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 78,40
            Q 70,48 60,52
            L 54,54" />

    <!-- Tonearm shadow (thin black line just under the white arm for depth) -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 79,41
            Q 71,49 61,53
            L 55,55" />

    <!-- Headshell (small rectangle where the needle is, on the record) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="0.5"
        android:pathData="M 50,52 L 58,52 L 58,56 L 50,56 Z" />

    <!-- ===== SPEED SLIDER (right side, vertical track with knob) ===== -->
    <!-- Slider track (vertical line) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M 84,42 L 84,72" />

    <!-- Slider knob (small circle on the track) -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="0.5"
        android:pathData="M 84,58
            m -2.5,0
            a 2.5,2.5 0 1,0 5,0
            a 2.5,2.5 0 1,0 -5,0
            Z" />

    <!-- ===== 45RPM ADAPTER HOLE (top-right corner, small circle) ===== -->
    <path
        android:fillColor="#000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.6"
        android:pathData="M 82,30
            m -2,0
            a 2,2 0 1,0 4,0
            a 2,2 0 1,0 -4,0
            Z" />

    <!-- ===== KNOB (bottom-left, round) ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="0.5"
        android:pathData="M 26,76
            m -3,0
            a 3,3 0 1,0 6,0
            a 3,3 0 1,0 -6,0
            Z" />

    <!-- Knob indicator (small black line) -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="0.8"
        android:fillColor="#00000000"
        android:pathData="M 26,74 L 26,72" />

    <!-- ===== SQUARE BUTTON (next to knob, bottom-left) ===== -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="0.5"
        android:pathData="M 32,73 L 38,73 L 38,79 L 32,79 Z" />

    <!-- ===== FEET (four small rectangles under the body) ===== -->
    <path
        android:fillColor="#000000"
        android:pathData="M 22,87 L 26,87 L 26,90 L 22,90 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M 82,87 L 86,87 L 86,90 L 82,90 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M 22,87 L 26,87 L 26,90 L 22,90 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M 82,87 L 86,87 L 86,90 L 82,90 Z" />

    <!-- Subtle shadow under the body (depth effect) -->
    <path
        android:fillColor="#000000"
        android:fillAlpha="0.2"
        android:pathData="M 22,87 L 86,87 L 86,89 L 22,89 Z" />

</vector>