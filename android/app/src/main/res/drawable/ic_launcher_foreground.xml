<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Classic gramophone silhouette:
        - Large morning-glory horn (flower-shaped) on top-left
        - Curved neck tapering down to the box
        - Rectangular wooden box base
        - Crank on the right side
        - Tonearm going from box up to horn opening
        Centered in the 108x108 canvas with safe-zone padding (~24dp).
    -->

    <!-- Horn opening: large ellipse (the bell of the gramophone) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 30,28
            C 18,28 12,40 12,52
            C 12,64 20,72 32,72
            L 50,72
            C 62,72 68,62 68,50
            C 68,38 60,28 48,28
            Z" />

    <!-- Horn inner shadow (creates depth) -->
    <path
        android:fillColor="#FFB87A"
        android:pathData="M 34,34
            C 26,34 22,42 22,50
            C 22,58 28,64 36,64
            L 46,64
            C 54,64 58,58 58,50
            C 58,42 52,34 44,34
            Z" />

    <!-- Horn center dot (where sound comes out) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 40,50
            m -6,0
            a 6,6 0 1,0 12,0
            a 6,6 0 1,0 -12,0
            Z" />

    <!-- Neck of the horn (tapering tube from horn down to box) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 38,72
            L 50,72
            L 56,84
            L 44,84
            Z" />

    <!-- Tonearm: thin bar going from box up to horn opening -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 60,82
            L 66,82
            L 50,56
            L 46,58
            Z" />

    <!-- Tonearm pivot (small circle on the box) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 63,82
            m -5,0
            a 5,5 0 1,0 10,0
            a 5,5 0 1,0 -10,0
            Z" />

    <!-- Wooden box base (the gramophone cabinet) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 30,82
            L 78,82
            C 82,82 84,84 84,88
            L 84,96
            C 84,98 82,100 78,100
            L 30,100
            C 26,100 24,98 24,96
            L 24,88
            C 24,84 26,82 30,82
            Z" />

    <!-- Box front panel divider line (decorative) -->
    <path
        android:fillColor="#FFB87A"
        android:pathData="M 30,90
            L 78,90
            L 78,92
            L 30,92
            Z" />

    <!-- Crank handle on the right side of the box -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 84,90
            L 92,90
            L 92,94
            L 84,94
            Z" />

    <!-- Crank knob (small circle at end) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 94,92
            m -3,0
            a 3,3 0 1,0 6,0
            a 3,3 0 1,0 -6,0
            Z" />

    <!-- Turntable disc visible on top of box (small ellipse) -->
    <path
        android:fillColor="#FFB87A"
        android:pathData="M 50,82
            m 0,-1
            a 14,2 0 1,0 28,0
            a 14,2 0 1,0 -28,0
            Z" />

</vector>